# Variáveis de ambiente necessárias em produção (Render).
# Este arquivo é só documentação — o Spring Boot não lê .env diretamente;
# em produção essas vars devem ser cadastradas no painel do host (Render).
# Localmente, os defaults do application.yml já cobrem o dev (Postgres local).

# Banco de dados (Supabase Postgres)
DB_URL=jdbc:postgresql://<host>.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=

# E-mail (SMTP para recuperação de senha)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Segurança
# Gerar com: openssl rand -base64 32
JWT_SECRET=

# URLs
FRONTEND_URL=https://<seu-projeto>.vercel.app
CORS_ALLOWED_ORIGINS=https://<seu-projeto>.vercel.app

# Supabase Storage (upload de foto de perfil)
SUPABASE_URL=https://<projeto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=profile-photos
